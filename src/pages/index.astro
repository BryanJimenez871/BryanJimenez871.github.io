---
import { ArrowDown, ArrowRight, ExternalLink, GitBranch, Mail, X } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";

const techTools = [
  ["Docker", "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg"],
  ["Airflow", "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/apacheairflow/apacheairflow-original.svg"],
  ["BigQuery", "https://cdn.simpleicons.org/googlebigquery/669DF6"],
  ["Power BI", "https://upload.wikimedia.org/wikipedia/commons/c/cf/New_Power_BI_Logo.svg"],
  ["Python", "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg"],
  ["PostgreSQL", "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg"],
  ["Linux", "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg"],
  ["Pandas", "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pandas/pandas-original.svg"],
  ["FastAPI", "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fastapi/fastapi-original.svg"],
];
---

<Layout title="Bryan Jiménez | Backend & Data Engineering" description="Portafolio de Bryan Jiménez: desarrollo backend, automatización, procesos ETL e ingeniería de datos con Python, FastAPI, Airflow y BigQuery.">
  <main id="contenido">
    <section id="inicio" class="hero shell">
      <div class="hero-copy reveal">
        <h1><span>Bryan Jimenez Huamani</span></h1>
        <p class="hero-lead">Soy <strong>Ingeniero Civil en Computación</strong>, enfocado, automatización, base de datos, procesos ETL y soluciones cloud.</p>
        <p class="hero-intent">Me interesa construir sistemas que conecten software, datos y automatización de una forma clara y mantenible.</p>
        <div class="hero-actions"><a class="button" href="#proyectos">Ver proyectos <ArrowDown size={18} aria-hidden="true" /></a></div>
      </div>
      <div class="hero-visual reveal" aria-label="Herramientas tecnológicas de Bryan"><div class="tech-orbit"><span class="orbit-ring orbit-ring-outer" aria-hidden="true"></span><span class="orbit-ring orbit-ring-inner" aria-hidden="true"></span><div class="orbit-core"><img src="/cat-core.png" alt="Gato frente a un computador" width="862" height="538" loading="lazy" /></div>{techTools.map(([name, icon], index) => <div class={`tech-node tech-node-${index + 1}`}><img src={icon} alt={name} width="36" height="36" loading="lazy" /><span>{name}</span></div>)}</div></div>
    </section>

    <section id="proyectos" class="section projects-section">
      <div class="shell">
        <div class="section-heading reveal"><h2>Proyectos destacados.</h2></div>
        <div class="projects-grid">
          <article class="project-preview reveal" aria-labelledby="habitos-title"><h3 id="habitos-title">Arquitectura de datos: de PostgreSQL a BigQuery</h3><p>{projects[0].summary}</p><div class="architecture" aria-label="Ciclo del proyecto Hábitos Personales"><span>PySide6</span><ArrowRight size={15} /><span>FastAPI</span><ArrowRight size={15} /><span>PostgreSQL</span><ArrowRight size={15} /><span>Airflow</span><ArrowRight size={15} /><span>BigQuery</span></div><button class="project-button" type="button" data-open-project="habitos">Ver proyecto <ArrowRight size={17} /></button></article>
          <article class="project-preview reveal" aria-labelledby="fastcheck-title"><h3 id="fastcheck-title">{projects[1].title}</h3><p>{projects[1].summary}</p><div class="architecture" aria-label="Ciclo del proyecto FastCheck"><span>Web Scraping</span><ArrowRight size={15} /><span>API de ChatGPT</span><ArrowRight size={15} /><span>ETL</span><ArrowRight size={15} /><span>Dataset validado</span></div><button class="project-button" type="button" data-open-project="fastcheck">Ver proyecto <ArrowRight size={17} /></button></article>
        </div>
      </div>
    </section>

    <section id="contacto" class="contact-section"><div class="shell contact-inner reveal"><h2>Contacto</h2><div class="social-row contact-links" aria-label="Perfiles profesionales"><a href="mailto:jimenezbryan871@gmail.com" aria-label="Enviar correo a Bryan"><Mail size={19} /><span>jimenezbryan871@gmail.com</span></a><a href="https://www.linkedin.com/in/bryan-jimenez-huamani" target="_blank" rel="noreferrer" aria-label="LinkedIn de Bryan"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.44A2.06 2.06 0 1 1 5.34 3.32a2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z" /></svg><span>linkedin.com/in/bryan-jimenez-huamani</span></a><a href="https://github.com/BryanJimenez871" target="_blank" rel="noreferrer" aria-label="GitHub de Bryan"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path fill="currentColor" d="M12 .5A11.5 11.5 0 0 0 8.36 22.91c.58.1.79-.25.79-.56v-2.17c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.29-5.27-5.73 0-1.27.45-2.3 1.2-3.11-.12-.3-.52-1.48.11-3.08 0 0 .97-.31 3.17 1.19a11 11 0 0 1 5.77 0c2.2-1.5 3.17-1.19 3.17-1.19.63 1.6.23 2.78.11 3.08.75.81 1.2 1.84 1.2 3.11 0 4.45-2.7 5.43-5.28 5.72.41.36.78 1.08.78 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg><span>github.com/BryanJimenez871</span></a></div></div></section>
  </main>

  <dialog id="habitos-dialog" class="project-dialog" aria-labelledby="habitos-dialog-title"><div class="dialog-panel"><button class="dialog-close" type="button" data-close-project aria-label="Cerrar proyecto"><X size={20} /></button><div class="project-content"><p class="eyebrow">{projects[0].eyebrow}</p><h2 id="habitos-dialog-title">{projects[0].title}</h2></div><section class="project-media" aria-label="Capturas del proyecto"><div class="media-tabs" role="tablist" aria-label="Áreas del proyecto"><button id="tab-aplicacion" type="button" role="tab" aria-selected="true" aria-controls="panel-aplicacion" data-media-tab="panel-aplicacion">Aplicación</button><button id="tab-graficos" type="button" role="tab" aria-selected="false" aria-controls="panel-graficos" data-media-tab="panel-graficos">Gráficos</button><button id="tab-fastapi" type="button" role="tab" aria-selected="false" aria-controls="panel-fastapi" data-media-tab="panel-fastapi">FastAPI</button><button id="tab-docker" type="button" role="tab" aria-selected="false" aria-controls="panel-docker" data-media-tab="panel-docker">Docker</button><button id="tab-airflow" type="button" role="tab" aria-selected="false" aria-controls="panel-airflow" data-media-tab="panel-airflow">Airflow</button><button id="tab-bigquery" type="button" role="tab" aria-selected="false" aria-controls="panel-bigquery" data-media-tab="panel-bigquery">BigQuery</button><button id="tab-powerbi" type="button" role="tab" aria-selected="false" aria-controls="panel-powerbi" data-media-tab="panel-powerbi">Power BI</button></div><figure id="panel-aplicacion" class="media-panel" role="tabpanel" aria-labelledby="tab-aplicacion"><img src="/projects/habitos-interface.webp" alt="Interfaz de la aplicación Hábitos Personales" width="920" height="590" loading="lazy" /><figcaption>Registro y seguimiento diario de hábitos desde la aplicación de escritorio.</figcaption></figure><figure id="panel-graficos" class="media-panel" role="tabpanel" aria-labelledby="tab-graficos" hidden><img src="/projects/habitos-graph.webp" alt="Visualización de hábitos personales" width="460" height="290" loading="lazy" /><figcaption>Gráficos para revisar el progreso de los hábitos registrados.</figcaption></figure><figure id="panel-fastapi" class="media-panel" role="tabpanel" aria-labelledby="tab-fastapi" hidden><img src="/projects/habitos-api.webp" alt="Documentación de la API de Hábitos Personales" width="460" height="290" loading="lazy" /><figcaption>API REST para centralizar los datos y exponerlos a otros servicios.</figcaption></figure><figure id="panel-docker" class="media-panel" role="tabpanel" aria-labelledby="tab-docker" hidden><img src="/projects/habitos-docker.png" alt="Terminal levantando los servicios del proyecto con Docker Compose" width="868" height="235" loading="lazy" /><figcaption>Entorno reproducible levantado con Docker Compose para orquestar Airflow, PostgreSQL y Redis.</figcaption></figure><figure id="panel-airflow" class="media-panel" role="tabpanel" aria-labelledby="tab-airflow" hidden><img src="/projects/habitos-airflow.png" alt="Flujo exitoso del pipeline en Apache Airflow" width="976" height="200" loading="lazy" /><figcaption>Pipeline que extrae datos de PostgreSQL y los carga en BigQuery.</figcaption></figure><figure id="panel-bigquery" class="media-panel media-panel-bigquery" role="tabpanel" aria-labelledby="tab-bigquery" hidden><div class="bigquery-captures"><article><img src="/projects/habitos-bigquery-dataset.png" alt="Dataset y tabla de hábitos creados en BigQuery" width="615" height="223" loading="lazy" /><p>Dataset y tabla de hábitos disponibles en BigQuery.</p></article><article><img src="/projects/habitos-bigquery-query.png" alt="Consulta SQL y resultados de hábitos en BigQuery" width="537" height="458" loading="lazy" /><p>Consulta SQL para validar los registros cargados.</p></article></div><figcaption>Datos centralizados en BigQuery, listos para consulta y visualización.</figcaption></figure><figure id="panel-powerbi" class="media-panel" role="tabpanel" aria-labelledby="tab-powerbi" hidden><img src="/projects/habitos-powerbi.png" alt="Informe de hábitos y visualizaciones en Power BI" width="1280" height="720" loading="lazy" /><figcaption>Dashboard para analizar avances y patrones de hábitos.</figcaption></figure></section><div class="project-content dialog-details"><div class="case-grid"><div><span>Contexto</span><p>{projects[0].context}</p></div><div><span>Mi aporte</span><p>{projects[0].contribution}</p></div><div><span>Resultado</span><p>{projects[0].result}</p></div></div><ul class="tags" aria-label="Tecnologías utilizadas">{projects[0].technologies.map((technology) => <li>{technology}</li>)}</ul><div class="project-links">{projects[0].links.map((link) => <a href={link.href} target="_blank" rel="noreferrer"><GitBranch size={17} /> {link.label} <ExternalLink size={14} /></a>)}</div></div></div></dialog>
  <dialog id="fastcheck-dialog" class="project-dialog" aria-labelledby="fastcheck-dialog-title"><div class="dialog-panel"><button class="dialog-close" type="button" data-close-project aria-label="Cerrar proyecto"><X size={20} /></button><div class="project-content"><p class="eyebrow">{projects[1].eyebrow}</p><h2 id="fastcheck-dialog-title">{projects[1].title}</h2><div class="case-grid"><div><span>Contexto</span><p>{projects[1].context}</p></div><div><span>Mi aporte</span><p>{projects[1].contribution}</p></div><div><span>Resultado</span><p>{projects[1].result}</p></div></div><ul class="tags" aria-label="Tecnologías utilizadas">{projects[1].technologies.map((technology) => <li>{technology}</li>)}</ul><section class="project-media fastcheck-media" aria-label="Evidencias de FastCheck"><div class="media-tabs" role="tablist" aria-label="Etapas de FastCheck"><button id="fastcheck-tab-publicacion" type="button" role="tab" aria-selected="true" aria-controls="fastcheck-panel-publicacion" data-media-tab="fastcheck-panel-publicacion">Publicación</button><button id="fastcheck-tab-metodologia" type="button" role="tab" aria-selected="false" aria-controls="fastcheck-panel-metodologia" data-media-tab="fastcheck-panel-metodologia">Metodología</button><button id="fastcheck-tab-analisis" type="button" role="tab" aria-selected="false" aria-controls="fastcheck-panel-analisis" data-media-tab="fastcheck-panel-analisis">Análisis</button></div><figure id="fastcheck-panel-publicacion" class="media-panel" role="tabpanel" aria-labelledby="fastcheck-tab-publicacion"><img src="/projects/fastcheck-publication.png" alt="Ejemplo de una publicación revisada por el proceso de FastCheck" width="256" height="497" loading="lazy" /><figcaption>Ejemplo del tipo de publicación analizada antes de extraer y validar sus datos.</figcaption></figure><figure id="fastcheck-panel-metodologia" class="media-panel" role="tabpanel" aria-labelledby="fastcheck-tab-metodologia" hidden><img src="/projects/fastcheck-methodology.png" alt="Flujo de scraping, clasificación con IA, validación y carga del dataset de FastCheck" width="1079" height="257" loading="lazy" /><figcaption>Flujo de extracción, clasificación con IA, validación y limpieza para construir el dataset final.</figcaption></figure><figure id="fastcheck-panel-analisis" class="media-panel" role="tabpanel" aria-labelledby="fastcheck-tab-analisis" hidden><img src="/projects/fastcheck-analysis.png" alt="Comparación de métricas textuales entre publicaciones falsas y verdaderas" width="438" height="458" loading="lazy" /><figcaption>Análisis comparativo del dataset: métricas de texto entre contenido falso y verdadero.</figcaption></figure></section></div></div></dialog>

  <script>
    const projectMedia = document.querySelector("#habitos-dialog .project-media"); document.querySelector("#habitos-dialog .project-links")?.before(projectMedia!);
    document.querySelectorAll("[data-open-project]").forEach((openButton) => openButton.addEventListener("click", () => document.querySelector<HTMLDialogElement>(`#${openButton.getAttribute("data-open-project")}-dialog`)?.showModal()));
    document.querySelectorAll("[data-close-project]").forEach((closeButton) => closeButton.addEventListener("click", () => closeButton.closest("dialog")?.close()));
    document.querySelectorAll<HTMLElement>(".project-media").forEach((media) => media.querySelectorAll<HTMLButtonElement>("[data-media-tab]").forEach((tab) => tab.addEventListener("click", () => { const panelId = tab.dataset.mediaTab; media.querySelectorAll<HTMLButtonElement>("[data-media-tab]").forEach((item) => item.setAttribute("aria-selected", String(item === tab))); media.querySelectorAll<HTMLElement>(".media-panel").forEach((panel) => { panel.hidden = panel.id !== panelId; }); })));
    document.querySelectorAll<HTMLDialogElement>(".project-dialog").forEach((dialog) => dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); }));
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("is-visible")), { threshold: 0.12 }); document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
  </script>
</Layout>
