---
import { ArrowDown, ArrowRight, Download, ExternalLink, GitBranch, Mail, Menu, X } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";

const navItems = [["Sobre mí", "#sobre-mi"], ["Proyectos", "#proyectos"], ["Contacto", "#contacto"]];
---

<Layout title="Bryan Jiménez | Backend & Data Engineering" description="Portafolio de Bryan Jiménez: desarrollo backend, automatización, procesos ETL e ingeniería de datos con Python, FastAPI, Airflow y BigQuery.">
  <header class="site-header" data-header>
    <nav class="shell nav-wrap" aria-label="Navegación principal">
      <a class="brand" href="#inicio" aria-label="Ir al inicio"><span>BJ</span><span class="brand-copy">Bryan Jiménez</span></a>
      <div class="desktop-nav">{navItems.map(([label, href]) => <a href={href}>{label}</a>)}</div>
      <a class="button button-small desktop-cv" href="/CV-Bryan-Jimenez.pdf" download><Download size={16} aria-hidden="true" /> CV</a>
      <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-button><Menu class="menu-open" size={22} aria-hidden="true" /><X class="menu-close" size={22} aria-hidden="true" /></button>
    </nav>
    <div class="mobile-nav" data-mobile-nav>{navItems.map(([label, href]) => <a href={href}>{label}</a>)}<a href="/CV-Bryan-Jimenez.pdf" download>Descargar CV</a></div>
  </header>

  <main id="contenido">
    <section id="inicio" class="hero shell">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span class="status-dot"></span> Disponible para nuevos desafíos</p>
        <h1>Construyo soluciones backend y convierto datos en <span>procesos útiles.</span></h1>
        <p class="hero-lead">Soy <strong>Bryan Jonathan Jiménez Huamani</strong>, Ingeniero Civil en Computación enfocado en APIs, automatización, procesos ETL y soluciones cloud.</p>
        <div class="hero-actions"><a class="button" href="#proyectos">Ver proyectos <ArrowDown size={18} aria-hidden="true" /></a><a class="button button-secondary" href="/CV-Bryan-Jimenez.pdf" download><Download size={18} aria-hidden="true" /> Descargar CV</a></div>
      </div>
      <div class="hero-visual reveal" aria-label="Presentación de Bryan Jiménez"><div class="portrait-frame"><img src="/profile.webp" width="520" height="520" alt="Bryan Jonathan Jiménez Huamani" fetchpriority="high" /><span class="portrait-grid" aria-hidden="true"></span></div></div>
    </section>

    <section id="sobre-mi" class="section shell">
      <div class="section-heading reveal"><p class="eyebrow">01 / Sobre mí</p><h2>Ingeniería con foco en resultados.</h2></div>
      <div class="about-grid reveal"><p class="about-lead">Me interesa construir sistemas que conecten software, datos y automatización de una forma clara y mantenible.</p><div class="about-copy"><p>Tengo experiencia desarrollando aplicaciones backend, procesos ETL, consultas SQL y soluciones que integran servicios cloud. Disfruto transformar tareas manuales en flujos reproducibles y bien documentados.</p><p>Trabajo principalmente con Python y tecnologías de datos. Mantengo una actitud de aprendizaje continuo y busco entender el problema antes de elegir las herramientas.</p></div></div>
    </section>

    <section id="proyectos" class="section projects-section">
      <div class="shell">
        <div class="section-heading reveal"><p class="eyebrow">02 / Proyectos destacados</p><h2>Proyectos destacados.</h2><p>Selecciona un proyecto para conocer la solución, las decisiones técnicas y los resultados.</p></div>
        <div class="projects-grid">
          <article class="project-preview reveal" aria-labelledby="habitos-title"><p class="eyebrow">{projects[0].eyebrow}</p><h3 id="habitos-title">{projects[0].title}</h3><p>{projects[0].summary}</p><div class="architecture" aria-label="Ciclo del proyecto Hábitos Personales"><span>PySide6</span><ArrowRight size={15} /><span>FastAPI</span><ArrowRight size={15} /><span>PostgreSQL</span><ArrowRight size={15} /><span>Airflow</span><ArrowRight size={15} /><span>BigQuery</span></div><button class="project-button" type="button" data-open-project="habitos">Ver proyecto <ArrowRight size={17} /></button></article>
          <article class="project-preview reveal" aria-labelledby="fastcheck-title"><div class="project-title-row"><div><p class="eyebrow">{projects[1].eyebrow}</p><h3 id="fastcheck-title">{projects[1].title}</h3></div><span class="private-label">Código no público</span></div><p>{projects[1].summary}</p><div class="architecture" aria-label="Ciclo del proyecto FastCheck"><span>Web Scraping</span><ArrowRight size={15} /><span>API de ChatGPT</span><ArrowRight size={15} /><span>ETL</span><ArrowRight size={15} /><span>Dataset validado</span></div><button class="project-button" type="button" data-open-project="fastcheck">Ver proyecto <ArrowRight size={17} /></button></article>
        </div>
      </div>
    </section>

    <section id="contacto" class="contact-section"><div class="shell contact-inner reveal"><p class="eyebrow">03 / Contacto</p><h2>Contacto</h2><div class="social-row" aria-label="Perfiles profesionales"><a href="mailto:jimenezbryan871@gmail.com" aria-label="Enviar correo a Bryan"><Mail size={19} /></a><a href="https://www.linkedin.com/in/bryan-jimenez-huamani" target="_blank" rel="noreferrer" aria-label="LinkedIn de Bryan"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.44A2.06 2.06 0 1 1 5.34 3.32a2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z" /></svg></a><a href="https://github.com/BryanJimenez871" target="_blank" rel="noreferrer" aria-label="GitHub de Bryan"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path fill="currentColor" d="M12 .5A11.5 11.5 0 0 0 8.36 22.91c.58.1.79-.25.79-.56v-2.17c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.29-5.27-5.73 0-1.27.45-2.3 1.2-3.11-.12-.3-.52-1.48.11-3.08 0 0 .97-.31 3.17 1.19a11 11 0 0 1 5.77 0c2.2-1.5 3.17-1.19 3.17-1.19.63 1.6.23 2.78.11 3.08.75.81 1.2 1.84 1.2 3.11 0 4.45-2.7 5.43-5.28 5.72.41.36.78 1.08.78 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg></a></div></div></section>
  </main>

  <dialog id="habitos-dialog" class="project-dialog" aria-labelledby="habitos-dialog-title"><div class="dialog-panel"><button class="dialog-close" type="button" data-close-project aria-label="Cerrar proyecto"><X size={20} /></button><div class="project-gallery"><figure class="gallery-main"><img src="/projects/habitos-interface.webp" alt="Interfaz de la aplicación Hábitos Personales" width="920" height="590" loading="lazy" /></figure><figure><img src="/projects/habitos-graph.webp" alt="Visualización de hábitos personales" width="460" height="290" loading="lazy" /></figure><figure><img src="/projects/habitos-api.webp" alt="Documentación de la API de Hábitos Personales" width="460" height="290" loading="lazy" /></figure></div><div class="project-content"><p class="eyebrow">{projects[0].eyebrow}</p><h2 id="habitos-dialog-title">{projects[0].title}</h2><div class="case-grid"><div><span>Contexto</span><p>{projects[0].context}</p></div><div><span>Mi aporte</span><p>{projects[0].contribution}</p></div><div><span>Resultado</span><p>{projects[0].result}</p></div></div><ul class="tags" aria-label="Tecnologías utilizadas">{projects[0].technologies.map((technology) => <li>{technology}</li>)}</ul><div class="project-links">{projects[0].links.map((link) => <a href={link.href} target="_blank" rel="noreferrer"><GitBranch size={17} /> {link.label} <ExternalLink size={14} /></a>)}</div></div></div></dialog>
  <dialog id="fastcheck-dialog" class="project-dialog" aria-labelledby="fastcheck-dialog-title"><div class="dialog-panel"><button class="dialog-close" type="button" data-close-project aria-label="Cerrar proyecto"><X size={20} /></button><div class="project-content"><div class="project-title-row"><div><p class="eyebrow">{projects[1].eyebrow}</p><h2 id="fastcheck-dialog-title">{projects[1].title}</h2></div><span class="private-label">Código no público</span></div><div class="case-grid"><div><span>Contexto</span><p>{projects[1].context}</p></div><div><span>Mi aporte</span><p>{projects[1].contribution}</p></div><div><span>Resultado</span><p>{projects[1].result}</p></div></div><ul class="tags" aria-label="Tecnologías utilizadas">{projects[1].technologies.map((technology) => <li>{technology}</li>)}</ul></div></div></dialog>

  <footer class="site-footer shell"><p>Diseñado y construido por Bryan Jiménez.</p><p>© {new Date().getFullYear()}</p></footer>

  <script>
    const header = document.querySelector("[data-header]"); const button = document.querySelector("[data-menu-button]"); const menu = document.querySelector("[data-mobile-nav]");
    const closeMenu = () => { button?.setAttribute("aria-expanded", "false"); menu?.classList.remove("is-open"); };
    button?.addEventListener("click", () => { const open = button.getAttribute("aria-expanded") === "true"; button.setAttribute("aria-expanded", String(!open)); menu?.classList.toggle("is-open", !open); });
    menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    document.querySelectorAll("[data-open-project]").forEach((openButton) => openButton.addEventListener("click", () => document.querySelector<HTMLDialogElement>(`#${openButton.getAttribute("data-open-project")}-dialog`)?.showModal()));
    document.querySelectorAll("[data-close-project]").forEach((closeButton) => closeButton.addEventListener("click", () => closeButton.closest("dialog")?.close()));
    document.querySelectorAll<HTMLDialogElement>(".project-dialog").forEach((dialog) => dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); }));
    const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 24); updateHeader(); window.addEventListener("scroll", updateHeader, { passive: true });
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("is-visible")), { threshold: 0.12 }); document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
  </script>
</Layout>
