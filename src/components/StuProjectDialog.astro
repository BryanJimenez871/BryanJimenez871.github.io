---
import { X } from "@lucide/astro";
import type { Project } from "../data/projects";

const { project } = Astro.props as { project: Project };
---

<dialog id="stu-dialog" class="project-dialog" aria-labelledby="stu-dialog-title">
  <div class="dialog-panel">
    <button class="dialog-close" type="button" data-close-project aria-label="Cerrar proyecto"><X size={20} /></button>
    <div class="project-content">
      <p class="eyebrow">{project.eyebrow}</p>
      <h2 id="stu-dialog-title">{project.title}</h2>
      <div class="case-grid">
        <div><span>Contexto</span><p>{project.context}</p></div>
        <div><span>Mi aporte</span><p>{project.contribution}</p></div>
        <div><span>Resultado</span><p>{project.result}</p></div>
      </div>
      <ul class="tags" aria-label="Herramientas y enfoques utilizados">
        {project.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
      <section class="project-media stu-media" aria-label="Evidencias del proyecto STU">
        <div class="media-tabs" role="tablist" aria-label="Áreas del proyecto STU">
          <button id="stu-tab-metodologia" type="button" role="tab" aria-selected="true" aria-controls="stu-panel-metodologia" data-media-tab="stu-panel-metodologia">Metodología</button>
          <button id="stu-tab-modelo" type="button" role="tab" aria-selected="false" aria-controls="stu-panel-modelo" data-media-tab="stu-panel-modelo">Modelo de negocio</button>
        </div>
        <figure id="stu-panel-metodologia" class="media-panel" role="tabpanel" aria-labelledby="stu-tab-metodologia">
          <img src="/projects/stu-methodology.png" alt="Metodología de gestión del proyecto de mejora para STU" width="1200" height="725" loading="lazy" />
          <figcaption>Metodología de cinco fases: planificación, investigación, diseño, control y entrega.</figcaption>
        </figure>
        <figure id="stu-panel-modelo" class="media-panel" role="tabpanel" aria-labelledby="stu-tab-modelo" hidden>
          <img src="/projects/stu-business-model.png" alt="Modelo de negocio propuesto para STU" width="864" height="648" loading="lazy" />
          <figcaption>Modelo de negocio que conecta propuesta de valor, recursos, operación y fuentes de ingreso.</figcaption>
        </figure>
      </section>
    </div>
  </div>
</dialog>
