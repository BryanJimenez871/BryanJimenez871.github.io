---
import { ArrowRight } from "@lucide/astro";
import type { Project } from "../data/projects";

const { project } = Astro.props as { project: Project };
---

<article class="project-preview project-preview-stu project-preview-wide reveal" aria-labelledby="stu-title">
  <h3 id="stu-title">{project.title}</h3>
  <p>{project.summary}</p>
  <div class="architecture" aria-label="Flujo del proyecto STU">
    <span>Modelo de negocio</span><ArrowRight size={15} /><span>Procesos TI</span><ArrowRight size={15} /><span>Oportunidades</span>
  </div>
  <button class="project-button" type="button" data-open-project="stu">Ver proyecto <ArrowRight size={17} /></button>
</article>
